NODE_ENV=development
PORT=5001

# developer — автоматический локальный пользователь; google — реальные пользователи.
AUTH_MODE=developer
# local — файлы на диске; google_drive — папка проекта в Drive каждого пользователя.
STORAGE_PROVIDER=local

VITE_CLIENT_URL=http://localhost:5173
VITE_SERVER_URL=http://localhost:5001

MONGODB_URI=mongodb://127.0.0.1:27017/aihub_development
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Необязательно: список Google-аккаунтов, которым разрешён вход.
GOOGLE_ALLOWED_EMAILS=

# Только для закрытого staging. Никогда не включайте на публичном production.
ALLOW_DEVELOPER_AUTH_IN_PRODUCTION=false
DEVELOPER_USER_ID=dev-user-id
DEVELOPER_USER_EMAIL=dev@local.host

SESSION_COOKIE_SAME_SITE=lax
PROJECTS_ROOT=./uploads/projects
MAX_FLOW_ARCHIVE_MB=100
