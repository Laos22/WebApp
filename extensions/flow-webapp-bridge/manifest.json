{
  "manifest_version": 3,
  "name": "Flow и DaVinci AI ↔ WebApp",
  "version": "0.7.3",
  "description": "Запускает генерацию в Flow и DaVinci AI из WebApp и возвращает результаты в проект.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://davinci.ai/*",
    "https://storage.googleapis.com/davinciweb-b8892.appspot.com/user-outputs/*",
    "http://localhost:5173/*",
    "https://aihub-webapp.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["flow-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://davinci.ai/app/video/*"],
      "js": ["davinci-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost:5173/projects/*",
        "https://aihub-webapp.onrender.com/projects/*"
      ],
      "js": ["webapp-content.js"],
      "run_at": "document_start"
    }
  ]
}
